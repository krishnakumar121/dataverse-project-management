# Power Automate Flow Definitions

## Flow 1: Task Reminder Notification

### Configuration

```json
{
  "name": "Task Reminder Notification",
  "type": "scheduled",
  "trigger": {
    "type": "recurrence",
    "frequency": "day",
    "interval": 1,
    "time": "08:00",
    "timezone": "UTC"
  },
  "actions": [
    {
      "name": "Get tasks due soon",
      "type": "data_operation",
      "operation": "list_records",
      "entity": "tasks",
      "filters": {
        "status": "<> Completed",
        "dueDate": "<= @addDays(utcNow(), 2)",
        "dueDate": ">= @utcNow()"
      }
    },
    {
      "name": "For each task",
      "type": "for_each",
      "items": "@body('Get_tasks_due_soon')?['value']",
      "actions": [
        {
          "name": "Get assigned user",
          "type": "lookup_record",
          "entity": "user",
          "filter": "id = @item().assignedto"
        },
        {
          "name": "Get project name",
          "type": "lookup_record",
          "entity": "project",
          "filter": "id = @item().project"
        },
        {
          "name": "Send reminder email",
          "type": "send_email",
          "to": "@body('Get_assigned_user')?['email']",
          "subject": "Task Reminder: @{item()['title']} due @{formatDateTime(item()['duedate'], 'MM/dd/yyyy')}",
          "body": "<html><body><h3>Task Reminder</h3><p>Your task <b>@{item()['title']}</b> is due on <b>@{formatDateTime(item()['duedate'], 'MMM dd, yyyy')}</b></p><p>Project: <b>@{body('Get_project_name')?['name']}</b></p><p><a href='@{concat(environment().record_url, item()['id'])}'>View Task</a></p></body></html>",
          "isBodyHTML": true,
          "importance": "high"
        },
        {
          "name": "Log activity",
          "type": "create_record",
          "entity": "activity",
          "data": {
            "subject": "Task reminder sent",
            "description": "Reminder notification sent to @{body('Get_assigned_user')?['email']}",
            "activitytype": "email",
            "regardingobjectid": "@item()['id']"
          }
        }
      ]
    }
  ],
  "errorHandling": {
    "retryPolicy": {
      "type": "exponential",
      "interval": "PT10S",
      "maxRetries": 3
    },
    "on_failure": [
      {
        "name": "Log error",
        "type": "send_notification",
        "recipient": "admin@company.com",
        "subject": "Flow Error: Task Reminder Notification"
      }
    ]
  }
}
```

