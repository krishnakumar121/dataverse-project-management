## Flow 5: Task Status Update Notification

### Configuration

```json
{
  "name": "Task Status Update Notification",
  "type": "automated",
  "trigger": {
    "type": "record_updated",
    "entity": "task",
    "changeType": "modified"
  },
  "conditions": [
    {
      "name": "Status changed",
      "expression": {
        "not": {
          "equals": [
            "@triggerBody()['status']",
            "@triggerOutputs()['body/previousdata']?['status']"
          ]
        }
      }
    }
  ],
  "actions": [
    {
      "name": "Get project owner",
      "type": "lookup_record",
      "entity": "project",
      "filter": "id = @triggerBody()['project']"
    },
    {
      "name": "Send notification",
      "type": "send_email",
      "to": "@body('Get_project_owner')?['owner_email']",
      "subject": "Task Updated: @{triggerBody()['title']} - Status changed to @{triggerBody()['status']}",
      "body": "<html><body><h3>Task Status Update</h3><p>Task <b>@{triggerBody()['title']}</b> status has changed</p><p><b>New Status:</b> @{triggerBody()['status']}</p><p><b>Assigned To:</b> @{triggerBody()['assignedto_name']}</p><p><b>Due Date:</b> @{formatDateTime(triggerBody()['duedate'], 'MMM dd, yyyy')}</p></body></html>",
      "isBodyHTML": true
    }
  ]
}
```

