## Flow 3: Risk Escalation

### Configuration

```json
{
  "name": "Risk Escalation",
  "type": "automated",
  "trigger": {
    "type": "record_created_or_updated",
    "entity": "riskregister",
    "changeType": ["created", "modified"]
  },
  "variables": [
    {
      "name": "riskScore",
      "type": "integer",
      "value": "@mul(int(triggerBody()['impact']), int(triggerBody()['probability']))"
    }
  ],
  "actions": [
    {
      "name": "Check if high risk",
      "type": "condition",
      "expression": {
        "and": [
          {
            "greaterOrEquals": ["@variables('riskScore')", 6]
          },
          {
            "or": [
              {"equals": ["@triggerBody()['status']", "Identified"]},
              {"equals": ["@triggerBody()['status']", "Monitoring"]}
            ]
          }
        ]
      },
      "actions_true": [
        {
          "name": "Get project owner",
          "type": "lookup_record",
          "entity": "project",
          "filter": "id = @triggerBody()['project']",
          "select": ["owner", "name"]
        },
        {
          "name": "Send escalation email",
          "type": "send_email",
          "to": "@body('Get_project_owner')?['owner_email']",
          "subject": "URGENT: High Risk Item Identified - Score @{variables('riskScore')}",
          "body": "<html><body><h2 style='color:red;'>⚠️ RISK ESCALATION</h2><p><b>Risk:</b> @{triggerBody()['description']}</p><p><b>Score:</b> @{variables('riskScore')}/9 (Critical)</p><p><b>Impact:</b> @{triggerBody()['impact']}<br/><b>Probability:</b> @{triggerBody()['probability']}</p><p><b>Mitigation Plan:</b><br/>@{triggerBody()['mitigationplan']}</p><p><b>Owner:</b> @{triggerBody()['owner_name']}</p><p><a href='@{environment().record_url}'>View Risk</a></p></body></html>",
          "isBodyHTML": true,
          "importance": "high",
          "needsResponse": true
        },
        {
          "name": "Create escalation task",
          "type": "create_record",
          "entity": "task",
          "data": {
            "title": "Risk Escalation: @{triggerBody()['description']}",
            "description": "High-risk item detected. Risk Score: @{variables('riskScore')}",
            "project": "@{triggerBody()['project']}",
            "assignedto": "@body('Get_project_owner')?['owner']",
            "priority": "Critical",
            "duedate": "@addDays(utcNow(), 1)",
            "status": "New"
          }
        }
      ]
    },
    {
      "name": "Check if critical",
      "type": "condition",
      "expression": {
        "equals": ["@variables('riskScore')", 9]
      },
      "actions_true": [
        {
          "name": "Send critical alert to management",
          "type": "send_email",
          "to": "management@company.com",
          "subject": "CRITICAL: Risk Score 9/9 - Immediate Action Required",
          "body": "<html><body><h1 style='color:red;'>🚨 CRITICAL RISK ALERT</h1><p>A critical risk has been identified requiring immediate management attention.</p><p><b>Risk:</b> @{triggerBody()['description']}</p><p><a href='@{environment().record_url}'>View Risk Details</a></p></body></html>",
          "isBodyHTML": true,
          "importance": "high"
        }
      ]
    }
  ]
}
```

