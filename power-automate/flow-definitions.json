## Flow 2: Milestone Alert Notification

### Configuration

```json
{
  "name": "Milestone Alert Notification",
  "type": "automated",
  "trigger": {
    "type": "record_created_or_updated",
    "entity": "milestone",
    "changeType": ["created", "modified"]
  },
  "actions": [
    {
      "name": "Get project details",
      "type": "lookup_record",
      "entity": "project",
      "filter": "id = @triggerBody()['project']"
    },
    {
      "name": "Check if approaching",
      "type": "condition",
      "expression": {
        "and": [
          {
            "less": [
              "@sub(int(formatDateTime(triggerBody()['targetdate'], 'x')), int(formatDateTime(utcNow(), 'x')))",
              "@mul(3, 24, 60, 60, 1000)"
            ]
          },
          {
            "not": {
              "equals": [
                "@triggerBody()['status']",
                "Completed"
              ]
            }
          }
        ]
      },
      "actions_true": [
        {
          "name": "Send alert email",
          "type": "send_email",
          "to": "@body('Get_project_details')?['owner_email']",
          "cc": "@body('Get_project_details')?['team_email']",
          "subject": "ALERT: Milestone '@{triggerBody()['name']}' approaching",
          "body": "<html><body><h2 style='color:red;'>Milestone Alert</h2><p>The milestone <b>@{triggerBody()['name']}</b> is due on <b>@{formatDateTime(triggerBody()['targetdate'], 'MMM dd, yyyy')}</b></p><p>Key Deliverables:<br/>@{replace(triggerBody()['deliverables'], '\n', '<br/>')}</p><p><a href='@{environment().record_url}'>View Milestone</a></p></body></html>",
          "isBodyHTML": true,
          "importance": "high",
          "categories": "[\"Milestone Alert\"]"
        },
        {
          "name": "Post to Teams",
          "type": "post_teams_message",
          "summary": "Milestone Alert",
          "themeColor": "FF0000",
          "sections": [
            {
              "activityTitle": "Milestone Alert: @{triggerBody()['name']}",
              "activitySubtitle": "Project: @{body('Get_project_details')?['name']}",
              "facts": [
                {
                  "name": "Due Date",
                  "value": "@{formatDateTime(triggerBody()['targetdate'], 'MMM dd, yyyy')}"
                },
                {
                  "name": "Status",
                  "value": "@{triggerBody()['status']}"
                },
                {
                  "name": "Days Until Due",
                  "value": "@{div(sub(int(formatDateTime(triggerBody()['targetdate'], 'x')), int(formatDateTime(utcNow(), 'x'))), 86400000)}"
                }
              ],
              "potentialAction": [
                {
                  "@type": "OpenUri",
                  "name": "View Milestone",
                  "targets": [
                    {
                      "os": "default",
                      "uri": "@{environment().record_url}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
```

