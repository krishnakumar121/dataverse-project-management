## Flow 4: Weekly Status Report

### Configuration

```json
{
  "name": "Weekly Project Status Report",
  "type": "scheduled",
  "trigger": {
    "type": "recurrence",
    "frequency": "week",
    "interval": 1,
    "daysOfWeek": ["Monday"],
    "time": "09:00",
    "timezone": "UTC"
  },
  "actions": [
    {
      "name": "Get active projects",
      "type": "data_operation",
      "operation": "list_records",
      "entity": "projects",
      "filters": {
        "status": "Active"
      }
    },
    {
      "name": "For each active project",
      "type": "for_each",
      "items": "@body('Get_active_projects')?['value']",
      "actions": [
        {
          "name": "Get task statistics",
          "type": "data_operation",
          "operation": "get_count",
          "entity": "tasks",
          "filters": "project = @item()['id']"
        },
        {
          "name": "Build status summary",
          "type": "compose",
          "inputs": {
            "projectName": "@item()['name']",
            "owner": "@item()['owner_email']",
            "status": "@item()['status']",
            "healthStatus": "@item()['health']",
            "completionPercent": "@item()['progress']",
            "totalTasks": "@body('Get_task_statistics')?['value']"
          }
        },
        {
          "name": "Send status report",
          "type": "send_email",
          "to": "@body('Build_status_summary')?['owner']",
          "subject": "Weekly Status Report: @{body('Build_status_summary')?['projectName']}",
          "body": "<html><body><h2>Weekly Project Status</h2><p><b>Project:</b> @{body('Build_status_summary')?['projectName']}</p><p><b>Status:</b> @{body('Build_status_summary')?['status']}</p><p><b>Health:</b> @{body('Build_status_summary')?['healthStatus']}</p><p><b>Completion:</b> @{body('Build_status_summary')?['completionPercent']}%</p><p><b>Total Tasks:</b> @{body('Build_status_summary')?['totalTasks']}</p></body></html>",
          "isBodyHTML": true
        }
      ]
    }
  ]
}
```

